# Copy this file to .env (which is git-ignored):
#   Copy-Item .env.example .env
#
# These are LOCAL DEVELOPMENT values only. Never reuse them anywhere real.
# The ledger service also reads ../../.env when you run it from your IDE.

# Postgres: a superuser for the container, plus two logins for the ledger service:
#   ledger_owner runs the Flyway migrations and owns the tables,
#   ledger_app is what the running service uses (no UPDATE/DELETE on ledger history).
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-superuser
LEDGER_OWNER_DB_PASSWORD=dev-ledger-owner
LEDGER_APP_DB_PASSWORD=dev-ledger-app

# Operator token for /admin/** (create merchants, run reconciliation). At least 32 characters.
ADMIN_API_TOKEN=dev-admin-token-0123456789abcdef0123456789abcdef

# Shared with the simulated payment provider:
#   the API key the ledger uses to call it, and the secret it signs webhooks with (32+ characters).
PROVIDER_API_KEY=dev-provider-api-key-0123456789
PROVIDER_WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef0123456789

# Host ports (all bound to 127.0.0.1). Chosen to avoid the other local stacks on this machine.
POSTGRES_HOST_PORT=35432
LEDGER_HOST_PORT=8480
PROVIDER_HOST_PORT=8481

# Optional, only when running a service from an IDE (Docker Compose sets these itself).
# The defaults shown are what the services use when the variable is absent.
# DB_URL=jdbc:postgresql://localhost:35432/payments
# DB_APP_USERNAME=ledger_app
# DB_OWNER_USERNAME=ledger_owner
# PROVIDER_BASE_URL=http://localhost:8481
# SIM_WEBHOOK_URL=http://localhost:8480/webhooks/provider
